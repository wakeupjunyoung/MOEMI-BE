# Server settings for docker compose. Copy to .env on the server and fill in the values:
#   cp .env.example .env
# .env is git-ignored. Never commit it or paste its values anywhere shared.

# --- Database (MariaDB container; created on first start with these values) ---
DB_USERNAME=moemi
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Feature 1, 2: KMA living weather index (data.go.kr, "Decoding" key) ---
KMA_SERVICE_KEY=

# --- Feature 3: road incidents (its.go.kr) ---
ITS_API_KEY=

# --- Feature 4: TAGO bus (data.go.kr; Encoding or Decoding key) ---
TAGO_SERVICE_KEY=
TAGO_DEFAULT_CITY_CODE=24

# --- Feature 5: travel time. ODsay = public transit (register this server's public IP at ODsay),
#     Kakao = car. Leave empty to skip; walking time works without keys. ---
ODSAY_API_KEY=
KAKAO_REST_API_KEY=

# --- Port on the VM (GSM SV forwards port 80 to the instance's HTTP port) ---
APP_PORT=80
